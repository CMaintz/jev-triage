{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "The CONTRACT says pin everything; Renovate is the update path. Keep Actions pinned to a digest and bump the digest + the trailing # vN comment together.",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "pinDigests": true
    },
    {
      "description": "Toolchain versions declared in mise.toml [tools].",
      "matchManagers": ["mise"],
      "groupName": "mise toolchain"
    },
    {
      "description": "Security fixes land fast and on their own, labelled.",
      "matchPackageNames": ["*"],
      "isVulnerabilityAlert": true,
      "labels": ["security"],
      "prPriority": 10
    }
  ],
  "lockFileMaintenance": { "enabled": true },
  "vulnerabilityAlerts": { "labels": ["security"] }
}
